---
import '@fontsource/poppins';
import { Header, Footer } from '../components';
import '../styles/global.css';

const seo = {
	title: 'ELAYADE ISMAIL, Full Stack Developer',
	description:
		'Elayade ismail is a Web developer specializing in building exceptional websites, applications, and everything in between.',
	image: '/og.png',
	url: 'www.elayade.dev',
	twitterUsername: '@object__0bject',
};
---

<!doctype html>
<html lang='en' class='dark scroll-smooth'>
	<head>
		<meta charset='UTF-8' />
		<meta name='title' content={seo.title} />
		<meta name='description' content={seo.description} />
		<meta name='viewport' content='width=device-width' />
		<meta name='image' content='/og.png' />
		<link rel='icon' type='image/svg+xml' href='/favicon.ico' />
		<meta name='generator' content={Astro.generator} />
		<link rel='sitemap' href='/sitemap-index.xml' />
		<meta property='og:title' content={seo.title} />
		<meta property='og:description' content={seo.description} />
		<meta property='og:image' content={seo.image} />
		<meta property='og:url' content={seo.url} />
		<meta property='og:type' content='website' />
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:creator' content={seo.twitterUsername} />
		<meta name='twitter:title' content={seo.title} />
		<meta name='twitter:description' content={seo.description} />
		<meta name='twitter:image' content={seo.image} />
		<title>{seo.title}</title>
	</head>
	<body class='min-h-screen antialiased bg-background text-foreground'>
		<div class='mx-auto mt-8 w-full max-w-2xl px-4 sm:px-6 lg:max-w-3xl'>
			<main id='home' class='mt-6 flex min-w-0 flex-auto flex-col'>
				<Header />
				<div id='content'>
					<slot />
					<Footer />
				</div>
			</main>
		</div>
	</body>
</html>
