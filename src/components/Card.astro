---
import ArrowIcon from './icons/arrow-icon.astro';

interface Props {
	title: string;
	body?: string;
	tech: string[];
	link: string;
	className?: string;
}

const { body, tech, title, link, className = '' } = Astro.props;
---

<li>
	<a
		class={`group mb-4 flex cursor-pointer flex-col gap-3 rounded-lg border border-transparent p-4 transition-colors motion-reduce:transition-none hover:border-border hover:bg-secondary/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 dark:hover:bg-secondary/20 lg:mb-12 lg:flex-row lg:gap-4 ${className}`}
		href={link}
		target='_blank'
		rel='noopener noreferrer'>
		<slot />
		<div class='flex flex-col'>
			<h3
				class='flex items-center text-base font-semibold leading-tight tracking-tight text-card-foreground group-hover:text-teal-600 dark:group-hover:text-teal-300 lg:text-xl'>
				{title}
				<span
					class='group-hover:text-teal-600 dark:group-hover:text-teal-300 ml-2 group-hover:-translate-y-0.5 transition'>
					<ArrowIcon />
				</span>
			</h3>
			<p
				class='mt-2 lg:text-sm text-xs leading-normal text-accent-foreground'>
				{body ?? ''}
			</p>
			<ul class='mt-2 flex flex-wrap'>
				{
					tech.map((_tech) => {
						return (
							<li class='mr-1.5 mt-2'>
								<div class='flex items-center rounded-full dark:bg-teal-400/10 bg-teal-300/10 px-3 py-1 text-xs font-medium leading-5 text-teal-600 dark:text-teal-300'>
									{_tech}
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</a>
</li>
