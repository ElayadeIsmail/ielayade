---
import ThemeIcon from './ThemeIcon.astro';
import Hamburger from './Hamburger.astro';
import { navItems } from '../constants';
---

<aside class='mb-8 tracking-tight'>
	<nav class='flex justify-between items-center'>
		<div class='flex-row space-x-3 hidden lg:block'>
			{
				Object.entries(navItems).map(([path, { name, options }]) => {
					return (
						<a
							href={path}
							{...options}
							class='no-underline transition-colors hover:text-teal-600 dark:hover:text-teal-300 hover:underline'>
							{name}
						</a>
					);
				})
			}
		</div>
		<Hamburger />
		<div>
			<ThemeIcon />
		</div>
	</nav>
</aside>
